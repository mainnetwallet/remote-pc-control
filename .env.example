# Access password, minimum 4 characters (12+ recommended). Change it with: .\scripts\set-password.ps1
REMOTE_PC_TOKEN=replace-with-your-password
REMOTE_PC_HOST=0.0.0.0
REMOTE_PC_PORT=8888
# Live screen: frames per second (1-30), JPEG quality (25-85), max frame width in px (0 = native)
REMOTE_PC_FPS=20
REMOTE_PC_JPEG_QUALITY=55
REMOTE_PC_MAX_WIDTH=1280
REMOTE_PC_SHOW_CURSOR=1
# Frames sent while the screen is moving use this percent of the JPEG quality (lower = less lag), a sharp frame follows at rest. 100 = off.
REMOTE_PC_MOTION_QUALITY=100
# ...and scaled to this percent of their width (50-100, 100 = off).
REMOTE_PC_MOTION_WIDTH=100
# auto = fast DXGI capture if dxcam is installed and works, otherwise mss. Set to mss to always use the old capture.
REMOTE_PC_CAPTURE=auto

# Free Cloudflare quick tunnel started by start.ps1 (link changes every run).
#QUICK_TUNNEL=1
# Optional: publish the new link to a secret GitHub Gist so the Android app finds it by itself.
# Create a CLASSIC token with ONLY the "gist" scope (do not reuse a repo token): https://github.com/settings/tokens
#GIST_TOKEN=your-gist-token
# 1 = keep the delay low: shrink the picture at once on a slow link, grow back slowly. 0 = always the configured quality.
REMOTE_PC_LATENCY_FIRST=1

# --- WebRTC live screen (low latency). The WebSocket JPEG stream above stays as the automatic fallback. ---
# 1 = offer WebRTC (video over UDP, H.264); 0 = WebSocket stream only.
REMOTE_PC_WEBRTC=1
# WebRTC video: maximum frames per second (1-30) and upper bitrate limit in kbit/s (300-30000). The app's quality preset can lower both.
REMOTE_PC_RTC_FPS=30
REMOTE_PC_RTC_BITRATE=4000
# H.264 encoder: auto = hardware (NVIDIA nvenc, Intel qsv, AMD amf) if it works, else libx264 (ultrafast, zerolatency). Or force: nvenc / qsv / amf / x264.
REMOTE_PC_RTC_ENCODER=auto
# STUN server(s), comma separated: lets phone and PC find a direct path. Default: Google's public STUN.
REMOTE_PC_STUN_URL=stun:stun.l.google.com:19302
# Optional TURN relay for networks where a direct connection is impossible (mobile CGNAT, strict firewalls), e.g. turn:turn.example.com:3478
# Leave empty to use none. The password stays on this PC and is sent only to clients that logged in with the token.
REMOTE_PC_TURN_URL=
REMOTE_PC_TURN_USER=
REMOTE_PC_TURN_PASS=
