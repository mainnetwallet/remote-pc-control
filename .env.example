# Access password, minimum 4 characters (12+ recommended). Change it with: .\scripts\set-password.ps1
REMOTE_PC_TOKEN=replace-with-your-password
REMOTE_PC_HOST=0.0.0.0
REMOTE_PC_PORT=8888
# Live screen: frames per second (1-30), JPEG quality (25-85), max frame width in px (0 = native)
REMOTE_PC_FPS=20
REMOTE_PC_JPEG_QUALITY=55
REMOTE_PC_MAX_WIDTH=1280
REMOTE_PC_SHOW_CURSOR=1
# Frames sent while the screen is moving use this percent of the JPEG quality (lower = less lag), a sharp frame follows at rest. 100 = off.
REMOTE_PC_MOTION_QUALITY=70
# ...and scaled to this percent of their width (50-100, 100 = off).
REMOTE_PC_MOTION_WIDTH=80
# auto = fast DXGI capture if dxcam is installed and works, otherwise mss. Set to mss to always use the old capture.
REMOTE_PC_CAPTURE=auto

# Free Cloudflare quick tunnel started by start.ps1 (link changes every run).
#QUICK_TUNNEL=1
# Optional: publish the new link to a secret GitHub Gist so the Android app finds it by itself.
# Create a CLASSIC token with ONLY the "gist" scope (do not reuse a repo token): https://github.com/settings/tokens
#GIST_TOKEN=your-gist-token
