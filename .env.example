# ===== Access =====
REMOTE_PC_TOKEN=replace-with-your-password
# HOST and PORT are used by the packaged RemotePCControl.exe only; scripts\start.ps1 always binds 0.0.0.0:8888.
REMOTE_PC_HOST=0.0.0.0
REMOTE_PC_PORT=8888

# ===== Tunnel (optional, read by scripts\start.ps1) =====
#QUICK_TUNNEL=1
#GIST_TOKEN=your-gist-token

# ===== Live screen: WebRTC (fast) =====
REMOTE_PC_WEBRTC=1
# Max frames per second: "auto" = what this PC can show (monitor refresh rate, up to 120), or a number 1-120.
# Run tools\pc_capability.py to see what your PC can do.
REMOTE_PC_RTC_FPS=auto
# 1 = always send the full frame rate, even on a still screen (phone shows max fps)
REMOTE_PC_RTC_STEADY=1
REMOTE_PC_RTC_BITRATE=4000
REMOTE_PC_RTC_ENCODER=auto

# ===== Network (STUN / TURN) =====
REMOTE_PC_STUN_URL=stun:stun.l.google.com:19302
REMOTE_PC_TURN_URL=
REMOTE_PC_TURN_USER=
REMOTE_PC_TURN_PASS=

# ===== Live screen: WebSocket fallback =====
# Starting frame rate: "auto" = what this PC can show (monitor refresh rate, up to 60), or a number 1-60.
# Clients (phone/browser quality presets) change it live; on a slow link the stream adapts by itself.
REMOTE_PC_FPS=auto
REMOTE_PC_JPEG_QUALITY=55
REMOTE_PC_MAX_WIDTH=1280
REMOTE_PC_LATENCY_FIRST=1
REMOTE_PC_MOTION_QUALITY=100
REMOTE_PC_MOTION_WIDTH=100

# ===== Capture =====
REMOTE_PC_CAPTURE=auto
REMOTE_PC_SHOW_CURSOR=1

# ===== PIN lock (optional; commented out = defaults) =====
# Which lock the app's Lock button uses: "pin" (default, when a PIN is set) or "windows".
#REMOTE_PC_LOCK_BUTTON=pin
# Where the lock state is stored (relative paths are relative to the project folder).
#REMOTE_PC_LOCK_STATE=lock_state.json
